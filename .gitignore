# Executables
ardopcf
CalcTemplates
/lib/txt2c/txt2c
/test/ardop/*
!/test/ardop/*.[ch]
!/test/ardop/*.bin
# Compiled core test harnesses (keep sources, ignore built binaries).
/test/core/*
!/test/core/*.[ch]

# Compiled golden core-decode harness (keep its source alongside the corpus).
/test/golden/core_decode_wav

# Python tests may write a variety of temporary files to /test/python/tmp/
/test/python/tmp/*

# temporary version of ardopSamples.c produced by CalcTemplates.
newArdopSampleArrays.c

# python bytecode
/test/python/__pycaches__
*.pyc

